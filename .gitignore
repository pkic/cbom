*:Zone.Identifier

# Jekyll build output and local tooling. docs/README.md tells contributors to
# run `bundle exec jekyll serve`, which produces all of these.
docs/_site/
docs/.jekyll-cache/
.bundle/
vendor/

# Output of tools/preview.py, the no-Jekyll preview of the methodology pages.
.preview/

# Python bytecode. A .pyc was committed by an over-eager `git add -A`;
# it is build output and does not belong in the repository.
__pycache__/
*.pyc
