{
  "policyFormat": "pkic.cbom.policy",
  "policyFormatVersion": "0.1",
  "policyId": "pkic.example.policy.algorithm-transition",
  "version": "0.3",
  "title": "Quantum-vulnerable algorithm transition (NIST IR 8547, final)",
  "status": "illustrative",
  "$comment": "An example policy, not advice. It applies the transition schedule of NIST IR 8547 (final, 27 October 2026) to the algorithms a CBOM discloses. Quantum-vulnerable signature and key-establishment algorithms are deprecated after 2030 and disallowed after 2035, at every approved security strength. The schedule is data in this file; the evaluation method is implemented by evaluate_policy.py. The judgement is computed at evaluation time and recorded in a result that points to the CBOM by digest, never stored in the CBOM. Check the schedule against the NIST publication before relying on it.",
  "source": {
    "title": "NIST IR 8547, Transition to Post-Quantum Cryptography Standards",
    "url": "https://csrc.nist.gov/pubs/ir/8547/final",
    "published": "2026-10-27",
    "status": "final"
  },
  "method": "algorithm-transition",
  "inputs": {
    "profiles": [
      "pkic.example.interface-disclosure"
    ],
    "attributes": [
      "keyExchange",
      "authentication",
      "encryption",
      "keyExchangeSupported",
      "authenticationSupported"
    ]
  },
  "classification": [
    {
      "names": [
        "RSA-1024"
      ],
      "family": "RSA",
      "securityStrength": 80,
      "quantumVulnerable": true
    },
    {
      "names": [
        "RSA-2048",
        "RS256",
        "RS384",
        "RS512",
        "PS256",
        "PS384",
        "PS512",
        "RSA-SHA256",
        "RSA-OAEP",
        "RSA-OAEP-256",
        "rsa_pkcs1_sha256",
        "rsa_pss_rsae_sha256",
        "rsa_pss_rsae_sha384",
        "rsa_pss_rsae_sha512",
        "rsa_pss_pss_sha256",
        "RSA-SHA384",
        "RSA-SHA512",
        "RSA-PKCS1-1.5-SHA-256",
        "RSA-PKCS1-1.5-SHA-384",
        "RSA-PKCS1-1.5-SHA-512",
        "RSA-PSS-SHA-256",
        "RSA-PSS-SHA-384",
        "RSA-PSS-SHA-512",
        "RSA-OAEP-SHA-1-MGF1-SHA-1",
        "RSA-OAEP-SHA-256-MGF1-SHA-256"
      ],
      "family": "RSA",
      "securityStrength": 112,
      "quantumVulnerable": true,
      "note": "JOSE and TLS names do not carry the RSA key size. They are classified at 112 bits, the strength of the RSA-2048 keys Keycloak generates by default; a record that states a larger key in its key material is classified by that key."
    },
    {
      "names": [
        "RSA-3072"
      ],
      "family": "RSA",
      "securityStrength": 128,
      "quantumVulnerable": true
    },
    {
      "names": [
        "ffdhe2048",
        "FFDHE-ffdhe2048"
      ],
      "family": "FFDH",
      "securityStrength": 112,
      "quantumVulnerable": true
    },
    {
      "names": [
        "ffdhe3072",
        "FFDHE-ffdhe3072"
      ],
      "family": "FFDH",
      "securityStrength": 128,
      "quantumVulnerable": true
    },
    {
      "names": [
        "X25519",
        "secp256r1",
        "P-256",
        "ECDH-ES",
        "ES256",
        "ECDSA-P256-SHA256",
        "ecdsa_secp256r1_sha256",
        "Ed25519",
        "EdDSA",
        "ed25519",
        "ECDSA-SHA256",
        "ECDHE-secp256r1",
        "ECDH"
      ],
      "family": "EC",
      "securityStrength": 128,
      "quantumVulnerable": true
    },
    {
      "names": [
        "secp384r1",
        "P-384",
        "ES384",
        "ecdsa_secp384r1_sha384",
        "ECDSA-SHA384",
        "ECDHE-secp384r1",
        "ECDSA-P-384-SHA-384"
      ],
      "family": "EC",
      "securityStrength": 192,
      "quantumVulnerable": true
    },
    {
      "names": [
        "X448",
        "Ed448",
        "ed448"
      ],
      "family": "EC",
      "securityStrength": 224,
      "quantumVulnerable": true
    },
    {
      "names": [
        "secp521r1",
        "P-521",
        "ES512",
        "ecdsa_secp521r1_sha512",
        "ECDSA-SHA512",
        "ECDHE-secp521r1",
        "ECDSA-P-521-SHA-512"
      ],
      "family": "EC",
      "securityStrength": 256,
      "quantumVulnerable": true
    },
    {
      "names": [
        "X25519MLKEM768",
        "SecP256r1MLKEM768",
        "SecP384r1MLKEM1024",
        "ML-KEM-768",
        "ML-KEM-1024",
        "ML-KEM-512"
      ],
      "family": "ML-KEM",
      "quantumVulnerable": false,
      "note": "Hybrid groups are classified by their post-quantum component."
    },
    {
      "names": [
        "ML-DSA-44",
        "ML-DSA-65",
        "ML-DSA-87",
        "mldsa44",
        "mldsa65",
        "mldsa87",
        "SLH-DSA-SHA2-128s",
        "SLH-DSA-SHAKE-128s"
      ],
      "family": "ML-DSA/SLH-DSA",
      "quantumVulnerable": false
    },
    {
      "names": [
        "AES-128",
        "AES-128-GCM",
        "AES-256-GCM",
        "ChaCha20-Poly1305",
        "HMAC-SHA512",
        "HS256",
        "HS384",
        "HS512",
        "HMAC-SHA-256",
        "HMAC-SHA-384"
      ],
      "family": "symmetric",
      "quantumVulnerable": false,
      "note": "Symmetric algorithms are outside the IR 8547 public-key transition."
    }
  ],
  "schedule": [
    {
      "when": {
        "quantumVulnerable": true,
        "securityStrengthBelow": 112
      },
      "status": "disallowed",
      "note": "Already disallowed under SP 800-131A."
    },
    {
      "when": {
        "quantumVulnerable": true,
        "securityStrengthAtLeast": 112
      },
      "deprecatedAfter": "2030-12-31",
      "disallowedAfter": "2035-12-31",
      "note": "The final report deprecates quantum-vulnerable algorithms after 2030 at every approved strength; the 2024 draft deprecated only 112-bit strength."
    },
    {
      "when": {
        "quantumVulnerable": false
      },
      "status": "acceptable"
    }
  ],
  "changelog": [
    {
      "version": "0.3",
      "date": "2026-11-22",
      "kind": "editorial",
      "summary": "Adds the CycloneDX cryptography registry form of each name the examples now use (for example RSA-PKCS1-1.5-SHA-256 beside RS256, ECDHE-secp384r1 beside secp384r1), with the same classification. The earlier names are kept, so records that use them classify as before."
    },
    {
      "version": "0.2",
      "date": "2026-11-15",
      "kind": "tightening",
      "summary": "Follows the final NIST IR 8547 (27 October 2026): quantum-vulnerable algorithms at 128 bits and above are now deprecated after 2030, as at 112 bits."
    },
    {
      "version": "0.1",
      "date": "2026-10-25",
      "summary": "Initial example."
    }
  ]
}
