        {
          "expression": "$.externalReferences[?(@.properties[?(@.name=='pkic:profile:context' && @.value=='vulnerability-statements')])]",
          "nativeName": "interface-disclosure#R2 vulnerability-statements",
          "relevance": "required",
          "rationale": "Where the producer publishes statements about whether this subject is affected by a vulnerability (VEX, CSAF VEX, or an exploitability statement). Either a fixed document, with a hash, or a feed or API, with its access protocol named. A producer that publishes none says so ('not-published'). Silence"
        },
        {
          "expression": "$.externalReferences[?(@.properties[?(@.name=='pkic:profile:context' && @.value=='advisories')])]",
          "nativeName": "interface-disclosure#R3 advisories",
          "relevance": "recommended",
          "rationale": "Where third-party or vendor advisories about the subject and its libraries are published, with the access protocol named: a web page, a CSAF provider, the OSV API or the GitHub advisory API. A machine-readable endpoint lets a consumer query by the package URLs the CBOM already carries."
        },
        {
          "expression": "$.externalReferences[?(@.properties[?(@.name=='pkic:profile:context' && @.value=='security-contact')])]",
          "nativeName": "interface-disclosure#R4 security-contact",
          "relevance": "recommended",
          "rationale": "Where to report a weakness or request a fuller disclosure. The objective lists 'request a fuller disclosure from the producer' as a decision option; without a contact, that option has no address."
        },
        {
          "expression": "$.inventories[*].components[*].externalReferences[?(@.properties[?(@.name=='pkic:profile:context' && @.value=='configuration-guidance')])]",
          "nativeName": "interface-disclosure#R5 configuration-guidance",
          "relevance": "required",
          "rationale": "If a product states that the operator decides an algorithm, the interface points to where the operator decides it. 'deployment-defined' without this pointer tells the operator that the decision is theirs and not how to make it."
        },
        {
          "expression": "$.externalReferences[?(@.properties[?(@.name=='pkic:profile:context' && @.value=='design-intent')])]",
          "nativeName": "interface-disclosure#R6 design-intent",
          "relevance": "optional",
          "rationale": "A threat model or design document. This is where design intention is recorded now that 'intended' is not an accepted stage: as context the record points to, not as a stage it reports."
        },
        {
          "expression": "$.externalReferences[?(@.properties[?(@.name=='pkic:profile:context' && @.value=='support-lifecycle')])]",
          "nativeName": "pqc-migration#R1 support-lifecycle",
          "relevance": "recommended",
          "rationale": "Where the supplier states how long this version is supported. A migration plan depends on whether the version deployed today will receive the release that enables post-quantum cryptography, or has to be replaced first. A supplier that publishes no support lifecycle says so."
        },
